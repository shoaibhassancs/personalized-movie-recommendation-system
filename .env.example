# Copy to .env (git-ignored) and fill in. Names only: no real values are committed.
POSTGRES_USER=pmrs
POSTGRES_PASSWORD=
POSTGRES_DB=pmrs
# postgresql+psycopg://USER:PASSWORD@127.0.0.1:5433/DBNAME  (use a URL-safe password)
DATABASE_URL=
# a separate database on the same server; the tests create and drop it. Name must end _test
TEST_DATABASE_URL=
# API: generate with: python -c "import secrets; print(secrets.token_urlsafe(48))" (>= 32 chars)
JWT_SECRET=
